    {
      "text": "and she hated getting wet.",
      "caps": "and she | !hated | getting ~wet.",
      "gap": 0.22
    },
    {
      "text": "While her friends splashed happily in the river,",
      "caps": "While her *friends | ~splashed | *happily | in the ~river,"
    },
    {
